<project name="discrete Group project" default="dist" basedir=".">
    <description>
        discreteGroup build file
    </description>
  
  <!-- set global properties for this build -->
  <property name="src" location="src"/>
  <property name="build" location="build"/>
  <property name="dist" location="dist"/>
  <property name="apidoc" location="doc/apidocs"/>
  <property name="stdlib" location="../lib"/>
	  <property name="jrlib" location="../../lokisrevernge/jreality/lib"/>
	<property name="weblib" location="/homes/geometer/gunn/WWW/webstart/jars-current"/>
  
  <target name="init">
    <mkdir dir="${build}"/>
    <mkdir dir="${dist}"/>
  </target>

  <target name="core" depends="init" description="compile the source " >
    <javac source="1.6" target="1.6" excludesfile="excludes.txt" srcdir="${src}" destdir="${build}" 
   	classpath="${stdlib}/jReality.jar:
   		${stdlib}/jh.jar:
   		${stdlib}/jReality.jar:
        ${stdlib}/jrworkspace.jar:
    	${stdlib}/anim.jar:
   		${jrlib}/jogl-all.jar:
   		${stdlib}/filedrop.jar:
    	${stdlib}/discretegroup.jar:
    	${stdlib}/projgeom.jar:
    	${stdlib}/charlesgunn.jar:
    	${stdlib}/java2d.jar:
    	lib/xpp3-1.1.4c.jar:
    	lib/xstream-1.4.2.jar:
   		${stdlib}/junit.jar:
   		${jrlib}/xstream.jar:
    	lib/antlr-2.7.5.jar:
    	${stdlib}/gavrog.jar" debug="true">
      <compilerarg line="-source 1.6" />
    </javac>
    <!--copy todir="build/discreteGroup/resources"> 
      <fileset dir="${src}/discreteGroup/resources">
      </fileset>
    </copy-->
    <copy todir="build"> <!-- copy shader progs -->
        <fileset dir="${src}">
          <exclude name="**/*.java"/>
          <exclude name="**/*.gif"/>
        </fileset>
      </copy>
  </target>

  <target name="dist" depends="core" description="generate the distribution" >
    <jar jarfile="${dist}/discretegroupCGG.jar" basedir="${build}">
	<manifest>
		<attribute name="Built-By" value="Charles Gunn"/>
		<attribute name="Implementation-Vendor" value="Charles Gunn"/>
		<attribute name="Implementation-Title" value="Discrete group package built on de.jtem.discretegroup"/>
	</manifest>
</jar>
  	<!--exec dir="dist" executable="ant" >
    		<arg line=" -f /net/MathVis/signJars.xml"/>
    	</exec>
    	<copy todir="${weblib}">
    		<fileset file="${dist}/discretegroupCGG.jar">
    		</fileset>
    	</copy-->
 		<copy todir="${stdlib}">
  		<fileset file="${dist}/discretegroupCGG.jar">
  		</fileset>
  	</copy>
  </target>

  <target name="javadoc">
    <javadoc destdir="${apidoc}" author="true" version="true" use="true" windowtitle="Template Project API">
      <packageset dir="src" defaultexcludes="yes">
        <include name="discreteGroup/**" />
      </packageset>
    </javadoc>
  </target>

  <target name="clean">
    <delete dir="${build}"/>
    <delete dir="${dist}"/>
    <delete dir="${apidoc}"/>
  </target>
  
</project>
